# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_format_command_parse_args () {
  SENSIBLE_OPEN_LOCATION="${SENSIBLE_OPEN_LOCATION}"
  SENSIBLE_OPEN_PRIVATE="${SENSIBLE_OPEN_PRIVATE:-false}"
  SENSIBLE_OPEN_USE_TAB="${SENSIBLE_OPEN_USE_TAB:-false}"

  while [ $# -gt 0 ]; do
    case $1 in
      -p | --private | -i | --incognito)
        SENSIBLE_OPEN_PRIVATE=true

        shift
        ;;
      -t | --tab)
        SENSIBLE_OPEN_USE_TAB=true

        shift
        ;;
      -h | --help)
        echo "USAGE: $0 [-p|--private|--incognito] [-t|--tab] <path-or-URL>"

        exit 0
        ;;
      --)
        shift

        break
        ;;
      *)
        SENSIBLE_OPEN_LOCATION="$1"

        shift
        ;;
    esac
  done

  [ -n "${SENSIBLE_OPEN_LOCATION}" ] || SENSIBLE_OPEN_LOCATION="$1"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_format_open_command () {
  local browser_nickname"$1"
  shift

  # Caller is responsible for having already parsed args, e.g.:
  #   _sensibleopen_format_command_parse_args "$@"

  local location="${SENSIBLE_OPEN_LOCATION}"
  local is_private=${SENSIBLE_OPEN_PRIVATE:-false}
  local is_tabbing=${SENSIBLE_OPEN_USE_TAB:-false}

  local open_options="$(
    _sensibleopen_format_options \
      "${browser_nickname}" "${options}" "${is_private}" "${is_tabbing}"
  )"

  local open_cmd="$( \
    _sensibleopen_format_command "${browser_nickname}" "${open_options}"
  )"

  if [ -n "${location}" ]; then
    # You can pass a relative path to `sensible-browser` (and Chrome)
    # on Linux, and it'll work; but on macOS, it gets treated differently,
    # e.g.,
    #   open -na 'Google Chrome' --args --new-window "./subdir"
    # opens the browser to the root-level path, `/subdir`.
    # So fully qualify the location.
    [ -e "${location}" ] && location="$(realpath -- "${location}")"
    # Quote it, in case spaces in path name.
    location="\"${location}\""
  fi

  # Uncomment to audit the command.
  #  >&2 printf '%s\n' "${open_cmd} ${open_options}${location}"

  printf '%s\n' "${open_cmd} ${open_options}${location}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_format_options () {
  local browser_nickname"$1"
  local options"$2"
  local is_private"$3"
  local is_tabbing="$4"

  local options=""
  options="$(_sensibleopen_add_option_is_private "${browser_nickname}" "${options}" "${is_private}")"
  options="$(_sensibleopen_add_option_new_window "${browser_nickname}" "${options}" "${is_tabbing}")"
  options="$(_sensibleopen_add_option_profiledir "${browser_nickname}" "${options}")"

  printf '%s' "${options}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_add_option_is_private () {
  local browser_nickname="$1"
  local options="$2"
  local is_private="${3:-false}"

  if ${is_private}; then
    if [ "${browser_nickname}" = 'chrome' ]; then
      options="${options}--incognito "
    elif [ "${browser_nickname}" = 'firefox' ]; then
      options="${options}--private-window "
    fi
  fi

  printf '%s' "${options}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_add_option_new_window () {
  local browser_nickname="$1"
  local options="$2"
  local is_tabbing="${3:-false}"

  if ! ${is_tabbing}; then
    if false \
      || [ "${browser_nickname}" = 'chrome' ] \
      || [ "${browser_nickname}" = 'firefox' ] \
    ; then
      options="${options}--new-window "
    fi
  fi

  printf '%s' "${options}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# 2022-01-05: Chrome recently added User Profiles, and opening a new
# window without specifying the profile defaults to the most recently
# used profile. Which can be annoying. The author's use case is that
# most of my browsing is done in the context of the default user, and
# then I have one-off windows open for a myriad of other accounts I
# use, mostly to access email. So invariably I want new windows to
# open in the context of the default user profile; and if I want to
# access another user profile, I'll do so directly using the Profile
# menu dropdown.
_sensibleopen_add_option_profiledir () {
  local browser_nickname="$1"
  local options="$2"

  if [ "${browser_nickname}" = 'chrome' ]; then
    options="${options}--profile-directory=Default "
  fi

  printf '%s' "${options}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# - Sending arguments to macOS browser requires two options to `open`.
#   - A basic `open -a 'Google Chrome' URL` opens a URL in new tab of
#     existing window, akin to a basic `sensible-browser URL` on Linux.
#   - The `open` has an `--args` option to precede pass-through options,
#     but you also need to add `-n` so open tries to open a new Chrome
#     instance, which Chrome will capture and kill, and pass control
#     back to the running instance, "but this is necessary to force
#     arguments to be read", according and thanks to georgegarside.
#     E.g.,
#       open -na "Google Chrome" --args --new-window URL
#     https://apple.stackexchange.com/a/305902/388088
_sensibleopen_format_command () {
  local browser_nickname="$1"
  local options="$2"

  local open_cmd=""
  if os_is_macos; then
    local browser_app
    browser_app="$(_sensibleopen_macOS_browser_app "${browser_nickname}")"

    if [ -z "${browser_app}" ]; then
      # Finicky.app is default browser.
      open_cmd="open"
      # Ignores 'options', but shouldn't be any.
      options=""
    else
      if [ -z "${options}" ]; then
        open_cmd="open -a"
      else
        # See comments before function, necessary for --args to be effective.
        open_cmd="open -na"
      fi

      open_cmd="${open_cmd} '${browser_app}'"
    fi

    if [ -n "${options}" ]; then
      open_cmd="${open_cmd} --args"
    fi
  else
    # The _sensibleopen_browser_nickname used $BROWSER to get the nickname
    # (which was either 'chrome' or 'firefox', used to simplify the
    # _sensibleopen_format_options function).
    # - Also, if BROWSER unset, would've exited by now.
    # - ALTLY: We could call /usr/bin/sensible-browser
    #     open_cmd='sensible-browser'
    open_cmd="${BROWSER}"
  fi

  printf "%s" "${open_cmd}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Use Hammerspoon hook to bring Chrome window to the front, in case
# it opened behind the frontmost window.
#
# - In the author's experience, after you first start Chrome, the
#   `open` command will create new windows in front, i.e., in front
#   of the terminal window wherein you called `sensible-open`. But
#   after a while, the new Chrome windows will start to open behind
#   the terminal window. (It might be because of the author's
#   Hammerspoon, skhd, and Karabiner Elements configs, and maybe
#   they do something to the terminal window attributes or to the
#   Chrome window attributes that makes this start happening.)
#   - When Chrome starts doing this, quitting and restarting it
#     makes new windows start opening in front of all other windows
#     again.
#
# - Fortunately, the Hammerspoon API includes a number of application
#   and window foregrounders that are more elegant than what Apple (or
#   AppleScript) offers.
#
#   - E.g., `open -a 'Google Chrome'` will front Chrome, but it also
#     brings all other visible Chrome windows above the current window.
#
#     And while you can still <Alt-Tab> to the most recently used window,
#     that window is now buried under a bunch of other Chrome windows.
#
#     (This not only bothers the author visually, but also conceptually.
#      Coming from the Linux (and before that, Windows) world, I'm used
#      to <Alt-Tab> switching to the next window in the visible stack,
#      and not to a buried window. (And I know that macOS is app-centric,
#      not window-centric, but it's one of those few quirks about macOS
#      that I still haven't got used to... and maybe never will... but
#      Hammerspoon lets me at least fool myself for a while longer.))
#
# REFER: https://github.com/DepoXy/macOS-Hammyspoony#🥄
# CXREF: ~/.kit/mOS/macOS-Hammyspoony/.hammerspoon/init.lua

_sensibleopen_focus_kludge () {
  local browser_nickname"$1"

  if ! os_is_macos; then

    return
  fi

  local browser_app
  if [ "${browser_nickname}" != 'finicky' ]; then
    browser_app="$(_sensibleopen_macOS_browser_app "${browser_nickname}")"
  else
    browser_app="$(_sensibleopen_macOS_finicky_default_browser)"
  fi

  if [ -z "${browser_app}" ]; then

    return
  fi

  local config_cfg="${HOME}/.hammerspoon/init.lua"
  local spoony_cfg="${MOSREPOSPATH:-${DOPP_KIT:-${HOME}/.kit}/mOS}/macOS-Hammyspoony/.hammerspoon/init.lua"

  if [ "$(realpath -- "${config_cfg}")" = "${spoony_cfg}" ]; then
    # BWARE: It takes a split second for Chrome to respond with the new
    # window. Though worst that happens if this runs to soon is that this
    # could bring another Chrome window to the front, and then the new
    # window on top (whereas setFrontmost will only bring one Chrome window
    # on top of the other visible windows).
    sleep 0.33

    # Uncomment to audit the command.
    #  >&2 echo "open -g \"hammerspoon://setFrontmost?app=${browser_app}\""

    open -g "hammerspoon://setFrontmost?app=${browser_app}"
  fi
}

_sensibleopen_macOS_finicky_default_browser () {
  local finicky_cfg="${HOME}/.finicky.js"

  if ! command -v node > /dev/null || ! [ -f "${finicky_cfg}" ]; then

    return 0
  fi

  # Parse "defaultBrowser" from ~/.finicky.js
  # - Note this isn't perfect, as the user could have written a
  #   handler for opening URLs from the terminal. But it's also
  #   very unlikely anyone is using sensible-open, Finicky, and
  #   macOS-Hammyspoony other than the author.
  /bin/bash -c '\
    node -e "$(< "${HOME}/.finicky.js");
    process.stdout.write(module.exports.defaultBrowser);"
  '
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

os_is_macos () {
  [ "$(uname)" = 'Darwin' ]
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# ================================================================= #
# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# *** <beg boilerplate `source_deps`: ------------------------------|
#                                                                   |

__sensibleopen_format_open_command__this_filename="_sensibleopen-format-open-command"

__sensibleopen_format_open_command__source_deps () {
  local sourced_all=true

  # On Bash, user can source this file from anywhere.
  # - If not Bash, user must `cd` to this file's parent directory first.
  local prefix="$(dirname -- "${__sensibleopen_format_open_command__this_fullpath}")"

  # USAGE: Load dependencies using path relative to this file, e.g.:
  #   _source_file "${prefix}" "../deps/path/to/lib" "dependency.sh"

  #                                                                 |
  # *** stop boilerplate> ------------------------------------------|

  __sensibleopen_format_open_command__source_file "${prefix}" "./" "_sensibleopen-browser-nickname"

  # *** <more boilerplate: -----------------------------------------|
  #                                                                 |

  ${sourced_all}
}

__sensibleopen_format_open_command__smells_like_bash () { declare -p BASH_SOURCE > /dev/null 2>&1; }

__sensibleopen_format_open_command__print_this_fullpath () {
  if __sensibleopen_format_open_command__smells_like_bash; then
    echo "$(realpath -- "${BASH_SOURCE[0]}")"
  elif [ "$(basename -- "$0")" = "${__sensibleopen_format_open_command__this_filename}" ]; then
    # Assumes this script being executed, and $0 is its path.
    echo "$(realpath -- "$0")"
  else
    # Assumes cwd is this script's parent directory.
    echo "$(realpath -- "${__sensibleopen_format_open_command__this_filename}")"
  fi
}

__sensibleopen_format_open_command__this_fullpath="$(__sensibleopen_format_open_command__print_this_fullpath)"

__sensibleopen_format_open_command__shell_sourced () {
  [ "$(realpath -- "$0")" != "${__sensibleopen_format_open_command__this_fullpath}" ]
}

__sensibleopen_format_open_command__source_file () {
  local prfx="${1:-.}"
  local depd="${2:-.}"
  local file="${3:-.}"

  local deps_dir="${prfx}/${depd}"
  local deps_path="${deps_dir}/${file}"

  # Just in case sourced file overwrites top-level `__sensibleopen_format_open_command__this_filename`,
  # cache our copy, should we need it for an error message.
  local _this_file_name="${__sensibleopen_format_open_command__this_filename}"

  if [ -f "${deps_path}" ]; then
    # SAVVY: Source files from their dirs, so they can find their deps.
    local before_cd="$(pwd -L)"
    cd "${deps_dir}"
    # SAVVY: If errexit, error while sourcing kills process immediately,
    # and error you see might indicate this source file, but the line
    # number for the file being sourced. E.g.,
    #   /path/to/bin/myapp: 442: export: Illegal option -f
    # where `442` is line number from, e.g., 'deps/lib/dep.sh'.
    if ! . "${deps_path}"; then
      >&2 echo "ERROR: Dependency ‘${file}’ returned nonzero when sourced"
      sourced_all=false
    fi
    cd "${before_cd}"
  else
    local depstxt=""
    [ "${prfx}" = "." ] || depstxt="in ‘${deps_dir}’ or "
    >&2 echo "ERROR: ‘${file}’ not found under ‘${deps_dir}’"
    if __sensibleopen_format_open_command__smells_like_bash; then
      >&2 echo "- GAFFE: This looks like an error with the ‘__sensibleopen_format_open_command__source_file’ arguments"
    else
      >&2 echo "- HINT: You must source ‘${_this_file_name}’ from its parent directory"
    fi
    sourced_all=false
  fi
}

# BONUS: You can use these aliases instead of the uniquely-named functions,
# just be aware not to call any alias after calling _source_deps.
_shell_sourced () { __sensibleopen_format_open_command__shell_sourced; }
_source_deps () { __sensibleopen_format_open_command__source_deps; }

__sensibleopen_format_open_command__source_deps_unset_cleanup () {
  unset -v __sensibleopen_format_open_command__this_filename
  unset -f __sensibleopen_format_open_command__print_this_fullpath
  unset -f __sensibleopen_format_open_command__shell_sourced
  unset -f _shell_sourced
  unset -f __sensibleopen_format_open_command__smells_like_bash
  unset -f __sensibleopen_format_open_command__source_deps
  unset -f _source_deps
  unset -f __sensibleopen_format_open_command__source_deps_unset_cleanup
  unset -f __sensibleopen_format_open_command__source_file
}

# USAGE: When this file is being executed, before doing stuff, call:
#   _source_deps
# - When this file is being sourced, call both:
#   _source_deps
#   __sensibleopen_format_open_command__source_deps_unset_cleanup

#                                                                   |
# *** end boilerplate `source_deps`> -------------------------------|

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# ================================================================= #
# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main () {
  set -e

  _source_deps

  _sensibleopen_format_open_command "$@"
}

if _shell_sourced; then
  _source_deps
  if __sensibleopen_format_open_command__smells_like_bash; then
    export -f _sensibleopen_format_open_command
  fi
else
  main "$@"
fi

__sensibleopen_format_open_command__source_deps_unset_cleanup
unset -f main

