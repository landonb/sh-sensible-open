#!/bin/sh
# vim:tw=0:ts=2:sw=2:et:norl:ft=bash
# Author: Landon Bouma (landonb &#x40; retrosoft &#x2E; com)
# Project: https://github.com/landonb/sh-sensible-open#☔
# License: MIT (See LICENSE file)

# 2021-01-28: SNYC_ME: See related functionality (Vim plugin):
#
#   https://github.com/embrace-vim/vim-webopen#🐣

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_browser_nickname() {
  local browser_nickname
  local bundle_id_or_path

  if os_is_macos; then
    bundle_id_or_path="$(_sensibleopen_macOS_default_browser)" || return $?
    if ! browser_nickname="$(
      _sensibleopen_macOS_bypass_finicky_unless_http_location "${bundle_id_or_path}"
    )"; then
      browser_nickname="$(_sensibleopen_macOS_browser_nickname "${bundle_id_or_path}")"
    fi
  else
    bundle_id_or_path="$(_sensibleopen_Linux_default_browser)" || return $?
    browser_nickname="$(_sensibleopen_Linux_browser_nickname "${bundle_id_or_path}")"
  fi

  if [ -z "${browser_nickname}" ]; then
    >&2 echo "ERROR: Unrecognized default browser: ${bundle_id_or_path}"

    exit 1
  fi

  printf "%s" "${browser_nickname}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_macOS_default_browser() {
  # CXREF: ~/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure.plist
  local proplist="${HOME}/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure.plist"

  # Guard clause: Ensure Property List exists (and, by extension, is-macOS).
  if [ ! -f "${proplist}" ]; then
    >&2 printf '%s\n' "ERROR: Not found: LaunchServices Property List: ‘${proplist}’"

    return 1
  fi

  # Guard clause: Ensure `jq` installed.
  if ! command -v jq >/dev/null 2>&1; then
    >&2 printf '%s\n' "ERROR: Missing ‘jq’: Try: ‘brew install jq’"

    return 1
  fi

  # Copy the Property List to a temporary location, before transforming it.
  local tempfile="$(mktemp -t sh-sensible-open--com.apple.launchservices.secure.plist--XXXX)"
  /usr/bin/env cp -f "${proplist}" "${tempfile}"

  # Convert the Property List to JSON.
  plutil -convert json "${tempfile}"

  # Note there are both 'http' or 'https' handlers.
  # - Does it matter? We can compare and complain, I suppose
  local handler_http=$(
    cat "${tempfile}" |
      /usr/bin/env jq -r '.LSHandlers[]  | select(.LSHandlerURLScheme == "http") | .LSHandlerRoleAll'
  )
  local handler_https=$(
    cat "${tempfile}" |
      /usr/bin/env jq -r '.LSHandlers[]  | select(.LSHandlerURLScheme == "https") | .LSHandlerRoleAll'
  )

  printf '%s' "${handler_http}"

  # (lb): I'd expect the handlers to match, but perhaps not.
  # MAYBE/2021-01-27: If anyone sees this fire, tell me how.
  if [ "${handler_http}" != "${handler_https}" ]; then
    >&2 printf 'HTTPS: %s' " ${handler_https}"
  fi

  command rm -- "${tempfile}"

  return 0
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# If you `open <file>`, even `open file://<file>`, macOS will use
# Finder, or your EDITOR, etc., but sensible-open (despite it's
# name) is used to open whatever the user specified *in the browser*,
# and only in the browser.
_sensibleopen_macOS_bypass_finicky_unless_http_location() {
  local bundle_id_or_path="$1"

  if [ "${bundle_id_or_path}" != 'net.kassett.finicky' ] ||
    echo "${SENSIBLE_OPEN_LOCATION}" | grep -q -e "^https\?:\/\/" \
    ; then
    # Not Finicky, or location is http(s)://

    return 1
  fi

  # Get the default browser for Finicky, e.g., "Google Chrome"
  local browser_app
  browser_app="$(_sensibleopen_macOS_finicky_default_browser)"

  if [ -z "${browser_app}" ]; then

    return 1
  fi

  _sensibleopen_macOS_browser_nickname_from_app_name "${browser_app}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_macOS_browser_nickname() {
  local bundle_id_or_path="$1"

  if [ "${bundle_id_or_path}" = 'com.google.chrome' ]; then
    printf 'chrome'
  elif [ "${bundle_id_or_path}" = 'org.mozilla.firefox' ]; then
    printf 'firefox'
  elif [ "${bundle_id_or_path}" = 'com.apple.safari' ]; then
    # /Applications/Sarari.app/Contents/MacOS/Safari
    # Note that Safari does not accept arguments.
    printf 'safari'
  elif [ "${bundle_id_or_path}" = 'com.brave.Browser' ]; then
    # FIXME: See if Brave supports CLI args.
    printf 'brave'
  elif [ "${bundle_id_or_path}" = 'company.thebrowser.Browser' ]; then
    # FIXME: See if Arc supports CLI args.
    printf 'arc'
  elif [ "${bundle_id_or_path}" = 'net.kassett.finicky' ]; then
    # https://github.com/johnste/finicky
    printf 'finicky'
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_macOS_browser_nickname_from_app_name() {
  local app_name="$1"

  if [ "${app_name}" = 'Google Chrome' ]; then
    printf 'chrome'
  elif [ "${app_name}" = 'Firefox' ]; then
    printf 'firefox'
  elif [ "${app_name}" = 'Safari' ]; then
    printf 'safari'
  elif [ "${app_name}" = 'Brave Browser' ]; then
    printf 'brave'
  elif [ "${app_name}" = 'Arc' ]; then
    printf 'arc'
  elif [ "${app_name}" = 'Finicky' ]; then
    printf 'finicky'
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_macOS_browser_app() {
  local browser_nickname"$1"

  if [ "${browser_nickname}" = 'chrome' ]; then
    printf 'Google Chrome'
  elif [ "${browser_nickname}" = 'firefox' ]; then
    printf 'Firefox'
  elif [ "${browser_nickname}" = 'safari' ]; then
    printf 'Sarafi'
  elif [ "${browser_nickname}" = 'brave' ]; then
    printf 'Brave Browser'
  elif [ "${browser_nickname}" = 'arc' ]; then
    printf 'Arc'
  elif [ "${browser_nickname}" = 'finicky' ]; then
    # Finicky shims to other browsers.
    # - Note that `open -na Finicky --args <URL>` doesn't do anything
    #   (nor does `open -a Finicky`).
    # - Here we print nothing, and caller will know to call bare
    #   `open <URL>`, which will invoke Finicky.
    printf ''
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_Linux_default_browser() {
  # Ref: /usr/bin/sensible-browser

  # NOTE: If ${BROWSER} not set, could try, e.g.,
  #
  #         $ sensible-browser --version
  #         Google Chrome 88.0.4324.96
  #         Mozilla Firefox 84.0.2
  #         Chromium 87.0.4280.66 Built on Ubuntu , running on LinuxMint 19.3

  if test -z "${BROWSER}"; then
    printf "ERROR: Please set the BROWSER environment variable to your desired browser.\n" >&2

    return 1
  fi

  printf "%s" "${BROWSER}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_sensibleopen_Linux_browser_nickname() {
  local bundle_id_or_path="$1"

  if false ||
    [ "$(basename -- "${bundle_id_or_path}")" = 'google-chrome' ] ||
    [ "$(basename -- "${bundle_id_or_path}")" = 'google-chrome-stable' ] ||
    [ "$(basename -- "${bundle_id_or_path}")" = 'chromium-browser' ] \
    ; then
    printf 'chrome'
  elif [ "$(basename -- "${bundle_id_or_path}")" = 'firefox' ]; then
    printf 'firefox'
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

os_is_macos() {
  [ "$(uname)" = 'Darwin' ]
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# ================================================================= #
# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

__sensibleopen_browser_nickname__this_filename="_sensibleopen-browser-nickname"

__sensibleopen_browser_nickname__smells_like_bash() { declare -p BASH_SOURCE >/dev/null 2>&1; }

__sensibleopen_browser_nickname__shell_sourced() {
  [ "$(basename -- "$0")" != "${__sensibleopen_browser_nickname__this_filename}" ]
}

if ! __sensibleopen_browser_nickname__shell_sourced; then
  _sensibleopen_browser_nickname "$@"
else
  if __sensibleopen_browser_nickname__smells_like_bash; then
    export -f _sensibleopen_browser_nickname
  fi
  unset -v __sensibleopen_browser_nickname__this_filename
  unset -f __sensibleopen_browser_nickname__smells_like_bash
  unset -f __sensibleopen_browser_nickname__shell_sourced
fi
