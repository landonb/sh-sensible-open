#!/bin/sh
# vim:tw=0:ts=2:sw=2:et:norl:ft=bash
# Author: Landon Bouma (landonb &#x40; retrosoft &#x2E; com)
# Project: https://github.com/landonb/sh-sensible-open#🪂
# License: MIT (See LICENSE file)

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

VERBOSE="${VERBOSE:-false}"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# FILTR/2023-12-20: When did this start? Chromium seems to be burping
# into the stream, e.g.,
#
#  $ sensible-open google.com
#  $ [17999:17999:0100/000000.361789:ERROR:zygote_linux.cc(662)] write: Broken pipe (32)
#  ▒
#
#  ^ With the cursor on a new black line.
sensible_open () {
  # Sets SENSIBLE_OPEN_* vars:
  # - SENSIBLE_OPEN_LOCATION, SENSIBLE_OPEN_PRIVATE, SENSIBLE_OPEN_USE_TAB
  _sensibleopen_format_command_parse_args "$@"

  local browser_nickname=""
  browser_nickname="$(_sensibleopen_browser_nickname)" ||
    return $?

  if ${VERBOSE:-false}; then
    >&2 echo "${browser_nickname}: $(
      _sensibleopen_format_open_command "${browser_nickname}" "$@"
    )"
  fi

  eval "$(
    _sensibleopen_format_open_command "${browser_nickname}" "$@"
  ) 2>&1 >/dev/null \
  | sed '/write: Broken pipe/d' &"

  _sensibleopen_focus_kludge "${browser_nickname}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# ================================================================= #
# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# *** <beg boilerplate `source_deps`: ------------------------------|
#                                                                   |

_sensible_open__this_filename="sensible-open"

_sensible_open__source_deps () {
  local sourced_all=true

  # On Bash, user can source this file from anywhere.
  # - If not Bash, user must `cd` to this file's parent directory first.
  local prefix="$(dirname -- "${_sensible_open__this_fullpath}")"

  # USAGE: Load dependencies using path relative to this file, e.g.:
  #   _source_file "${prefix}" "../deps/path/to/lib" "dependency.sh"

  #                                                                 |
  # *** stop boilerplate> ------------------------------------------|

  _sensible_open__source_file "${prefix}" "./" "_sensibleopen-format-open-command"
  # In lieu of the previous command calling its source_deps,
  # which it only does when executed (not sourced), do here:
  _sensible_open__source_file "${prefix}" "./" "_sensibleopen-browser-nickname"

  # *** <more boilerplate: -----------------------------------------|
  #                                                                 |

  ${sourced_all}
}

_sensible_open__smells_like_bash () { declare -p BASH_SOURCE > /dev/null 2>&1; }

_sensible_open__print_this_fullpath () {
  if _sensible_open__smells_like_bash; then
    echo "$(realpath -- "${BASH_SOURCE[0]}")"
  elif [ "$(basename -- "$0")" = "${_sensible_open__this_filename}" ]; then
    # Assumes this script being executed, and $0 is its path.
    echo "$(realpath -- "$0")"
  else
    # Assumes cwd is this script's parent directory.
    echo "$(realpath -- "${_sensible_open__this_filename}")"
  fi
}

_sensible_open__this_fullpath="$(_sensible_open__print_this_fullpath)"

_sensible_open__shell_sourced () {
  [ "$(realpath -- "$0")" != "${_sensible_open__this_fullpath}" ]
}

_sensible_open__source_file () {
  local prfx="${1:-.}"
  local depd="${2:-.}"
  local file="${3:-.}"

  local deps_dir="${prfx}/${depd}"
  local deps_path="${deps_dir}/${file}"

  # Just in case sourced file overwrites top-level `_sensible_open__this_filename`,
  # cache our copy, should we need it for an error message.
  local _this_file_name="${_sensible_open__this_filename}"

  if [ -f "${deps_path}" ]; then
    # SAVVY: Source files from their dirs, so they can find their deps.
    local before_cd="$(pwd -L)"
    cd "${deps_dir}"
    # SAVVY: If errexit, error while sourcing kills process immediately,
    # and error you see might indicate this source file, but the line
    # number for the file being sourced. E.g.,
    #   /path/to/bin/myapp: 442: export: Illegal option -f
    # where `442` is line number from, e.g., 'deps/lib/dep.sh'.
    if ! . "${deps_path}"; then
      >&2 echo "ERROR: Dependency ‘${file}’ returned nonzero when sourced"
      sourced_all=false
    fi
    cd "${before_cd}"
  else
    local depstxt=""
    [ "${prfx}" = "." ] || depstxt="in ‘${deps_dir}’ or "
    >&2 echo "ERROR: ‘${file}’ not found under ‘${deps_dir}’"
    if _sensible_open__smells_like_bash; then
      >&2 echo "- GAFFE: This looks like an error with the ‘_sensible_open__source_file’ arguments"
    else
      >&2 echo "- HINT: You must source ‘${_this_file_name}’ from its parent directory"
    fi
    sourced_all=false
  fi
}

# BONUS: You can use these aliases instead of the uniquely-named functions,
# just be aware not to call any alias after calling _source_deps.
_shell_sourced () { _sensible_open__shell_sourced; }
_source_deps () { _sensible_open__source_deps; }

_sensible_open__source_deps_unset_cleanup () {
  unset -v _sensible_open__this_filename
  unset -f _sensible_open__print_this_fullpath
  unset -f _sensible_open__shell_sourced
  unset -f _shell_sourced
  unset -f _sensible_open__smells_like_bash
  unset -f _sensible_open__source_deps
  unset -f _source_deps
  unset -f _sensible_open__source_deps_unset_cleanup
  unset -f _sensible_open__source_file
}

# USAGE: When this file is being executed, before doing stuff, call:
#   _source_deps
# - When this file is being sourced, call both:
#   _source_deps
#   _sensible_open__source_deps_unset_cleanup

#                                                                   |
# *** end boilerplate `source_deps`> -------------------------------|

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# ================================================================= #
# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main () {
  set -e

  _source_deps

  sensible_open "$@"
}

if _shell_sourced; then
  _source_deps
  if _sensible_open__smells_like_bash; then
    export -f sensible_open
  fi
else
  main "$@"
fi

_sensible_open__source_deps_unset_cleanup
unset -f main

